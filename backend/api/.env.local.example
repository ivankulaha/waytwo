SUPABASE_URL=https://your-project.supabase.co
# Dashboard → Settings → API Keys → Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Dashboard → Settings → API Keys → Secret (service_role JWT). Server-only; never put in the mobile app or EXPO_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt_here
# Browser / Expo web; native apps typically do not rely on CORS
CORS_ORIGIN=http://localhost:8081

# Azure Key Vault (optional). If set, missing secrets are loaded from Key Vault via DefaultAzureCredential.
# AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net
# Cache TTL in milliseconds (default: 3600000 = 1 hour)
# AZURE_KV_CACHE_TTL_MS=3600000
